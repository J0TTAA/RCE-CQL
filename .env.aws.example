# Crear .env con: bash scripts/prepare-aws-env.sh rce.tudominio.cl
# Los valores PLACEHOLDER se sustituyen sin guardar secretos en Git.
RCE_DOMAIN=REPLACE_DOMAIN
CORS_ORIGINS=https://REPLACE_DOMAIN
RCE_API_IMAGE=ghcr.io/j0ttaa/rce-cql-api:sha-REPLACE_COMMIT
RCE_WEB_IMAGE=ghcr.io/j0ttaa/rce-cql-web:sha-REPLACE_COMMIT

COMPOSE_PROFILES=local-translator
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
HAPI_BIND_ADDRESS=127.0.0.1
HAPI_PORT=8080
CQL_TRANSLATOR_BIND_ADDRESS=127.0.0.1
CQL_TRANSLATOR_PORT=8081

HAPI_BASE_URL=http://hapi:8080/fhir
HAPI_AUTH_BEARER_TOKEN=
CQL_TRANSLATOR_BASE_URL=http://cql-translator:8080
DEPENDENCY_TIMEOUT_MS=10000
HAPI_DB_NAME=hapi
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=REPLACE_DB_PASSWORD

ANONYMOUS_CLASSROOM_ENABLED=true
ANONYMOUS_SESSION_SECRET=REPLACE_SESSION_SECRET
ANONYMOUS_SESSION_COOKIE_NAME=rce_session
ANONYMOUS_SESSION_COOKIE_SECURE=true
ANONYMOUS_SESSION_COOKIE_SAMESITE=Lax
ANONYMOUS_SESSION_TTL_HOURS=8
CLASSROOM_DEFAULT_ID=clase-rce-cql
CLASSROOM_TEACHER_PASSCODE=REPLACE_TEACHER_PASSCODE

# Ocho pacientes base: uno infantil, uno adolescente, cuatro adultos y dos mayores.
# Solo se aplica al primer seed de esta instancia HAPI.
SYNTHEA_REFERENCE_DATE=20260726
SYNTHEA_CHILD_COUNT=1
SYNTHEA_ADOLESCENT_COUNT=1
SYNTHEA_ADULT_COUNT=4
SYNTHEA_OLDER_ADULT_COUNT=2
