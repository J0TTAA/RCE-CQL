# Puertos publicados solo en localhost
API_PORT=3000
WEB_PORT=5173
HAPI_PORT=8080
CQL_TRANSLATOR_PORT=8081

# Desarrollo local: levanta HAPI/PostgreSQL y el traductor.
COMPOSE_PROFILES=local-hapi,local-translator

# PostgreSQL de HAPI. Cambiar la clave en entornos compartidos.
HAPI_DB_NAME=hapi
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=rce-cql-local-only

# Configuracion del backend
HAPI_BASE_URL=http://hapi:8080/fhir
HAPI_AUTH_BEARER_TOKEN=
CQL_TRANSLATOR_BASE_URL=http://cql-translator:8080
DEPENDENCY_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:5173
ANONYMOUS_CLASSROOM_ENABLED=true
ANONYMOUS_SESSION_SECRET=rce-cql-local-anonymous-session-secret-change-me
ANONYMOUS_SESSION_COOKIE_NAME=rce_session
ANONYMOUS_SESSION_COOKIE_SECURE=false
ANONYMOUS_SESSION_COOKIE_SAMESITE=Lax
ANONYMOUS_SESSION_TTL_HOURS=8
CLASSROOM_DEFAULT_ID=demo-aula
CLASSROOM_TEACHER_PASSCODE=docente-rce-cql

# Poblacion local Synthea. La fecha y las semillas internas son fijas para que
# todos los alumnos obtengan los mismos pacientes.
SYNTHEA_REFERENCE_DATE=20260726
SYNTHEA_CHILD_COUNT=6
SYNTHEA_ADOLESCENT_COUNT=4
SYNTHEA_ADULT_COUNT=12
SYNTHEA_OLDER_ADULT_COUNT=8
