# Plantilla para desplegar el RCE contra un HAPI FHIR ya existente.
# Copiar a .env y reemplazar los valores marcados antes de iniciar Docker.

# Puertos publicados en el host. Mantener 127.0.0.1 si un reverse proxy
# como Nginx, Caddy, Traefik o Apache publicara la URL externa.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
HAPI_BIND_ADDRESS=127.0.0.1
CQL_TRANSLATOR_BIND_ADDRESS=127.0.0.1
API_PORT=3000
WEB_PORT=5173
HAPI_PORT=8080
CQL_TRANSLATOR_PORT=8081

# Modo servidor con HAPI institucional: no levantar HAPI ni PostgreSQL locales.
# local-translator levanta solo el traductor CQL local. Si tambien existe un
# traductor externo, dejar COMPOSE_PROFILES vacio y configurar CQL_TRANSLATOR_BASE_URL.
COMPOSE_PROFILES=local-translator

# URL del servidor FHIR R4 real vista desde el contenedor api.
# Debe apuntar al endpoint base FHIR, normalmente terminando en /fhir.
HAPI_BASE_URL=https://hapi.ejemplo.cl/fhir

# Autenticacion simple soportada actualmente por la API: Bearer token estatico.
# Dejar vacio si HAPI queda protegido por red/proxy institucional y no exige token.
HAPI_AUTH_BEARER_TOKEN=

# Traductor CQL. Con COMPOSE_PROFILES=local-translator usar el nombre del servicio.
CQL_TRANSLATOR_BASE_URL=http://cql-translator:8080
DEPENDENCY_TIMEOUT_MS=10000

# URL publica del RCE para CORS y cookies cuando corresponda.
# Si se usa la misma URL para web y /api, CORS casi no participa, pero dejarlo correcto.
CORS_ORIGINS=https://rce.ejemplo.cl

# Aula anonima. Cambiar el secreto y la clave docente en cada despliegue real.
ANONYMOUS_CLASSROOM_ENABLED=true
ANONYMOUS_SESSION_SECRET=change-this-server-session-secret-at-least-32-chars
ANONYMOUS_SESSION_COOKIE_NAME=rce_session
ANONYMOUS_SESSION_COOKIE_SECURE=true
ANONYMOUS_SESSION_COOKIE_SAMESITE=Lax
ANONYMOUS_SESSION_TTL_HOURS=8
CLASSROOM_DEFAULT_ID=clase-rce-cql
# Clave solicitada por la UI al cambiar de Alumno a Docente.
# Debe definirse antes de levantar Docker en servidor.
CLASSROOM_TEACHER_PASSCODE=change-this-teacher-passcode

# Synthea no se usa contra HAPI institucional. Estos valores solo aplican al
# perfil local-hapi + seed-data.
SYNTHEA_REFERENCE_DATE=20260726
SYNTHEA_CHILD_COUNT=6
SYNTHEA_ADOLESCENT_COUNT=4
SYNTHEA_ADULT_COUNT=12
SYNTHEA_OLDER_ADULT_COUNT=8
