# En el servidor se reutiliza el HAPI institucional y solo se levanta el
# traductor local. No habilitar el perfil local-hapi.
COMPOSE_PROFILES=local-translator

API_PORT=3000
HAPI_BASE_URL=https://hapi.example.org/fhir
HAPI_AUTH_BEARER_TOKEN=
CQL_TRANSLATOR_BASE_URL=http://cql-translator:8080
CQL_TRANSLATOR_PORT=8081
DEPENDENCY_TIMEOUT_MS=5000
CORS_ORIGINS=https://rce.example.org
